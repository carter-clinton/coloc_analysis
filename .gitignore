# ----------------------------------------------------------------------
# coloc_analysis .gitignore
#
# Conventions:
#   - Code (R/Py/Shell/Snakemake) is committed.
#   - Configuration (YAML/JSON/TSV manifests) is committed.
#   - Raw and processed data are NOT committed; they live at /rs1 and
#     are symlinked under data/ (see data/README.md).
#   - Results and logs are regeneratable; not committed.
#   - Conda environments are pinned via envs/*.yml and NOT via conda pkg
#     caches.
# ----------------------------------------------------------------------

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
~$*
*.swp
*.swo
*~
.vscode-server/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- R ---
.Rhistory
.RData
.Ruserdata
.Rproj.user/
*.Rproj

# --- Conda / env caches ---
.conda/
conda_envs/
conda_pkgs/
pip_cache/
pip_tmp/
miniconda*/

# --- Snakemake ---
.snakemake/

# --- Phase 1 local R library (testthat + deps, compiled for testthat-phase1) ---
.r_lib_phase1/

# --- Phase 0/5/9 downloaded reference data + upstream tool sources ---
# Reference data (~30 GB LDSC + MAGMA + HESS + 1kG VCFs) lands here during
# first-production runs; not committed per project convention. See
# data/reference/README.md if we ever add one.
data/reference/
# Upstream tool source clones (e.g., tools/hess/ — HESS Python 2.7 source
# from huwenboshi/hess). Re-cloneable via git clone; not vendored in-repo.
# Use tools/* (not tools/) so per-file re-includes work for audit artifacts.
tools/*
# Force-include MTAG vendoring audit artifacts (m2-00 Task 3 per D-M2-10):
# .git_pinned_commit pins the upstream SHA; .git_clone_log proves the
# --residcov_path CLI flag exists at vendoring time. These are tiny text
# files (audit-grade); the bulk MTAG source is re-cloneable via the SHA.
!tools/mtag/
tools/mtag/*
!tools/mtag/.git_pinned_commit
!tools/mtag/.git_clone_log

# --- Data: never commit actual data files, but track the symlinks that
# point at /rs1 so a fresh clone on the same HPC inherits the data layout ---
data/raw/*
data/processed/*
data/external/*
data/catalogs/*
!data/raw/region_analysis
!data/processed/region_analysis
!data/processed/genome_wide
!data/raw/README.md
!data/processed/README.md
!data/external/README.md
!data/catalogs/catalog_lock_manifest.tsv
!data/catalogs/README.md

# --- Results / logs: regeneratable, except legacy symlinks ---
results/*
results_identity_ld/
logs/
*.log
!results/README.md
!results/legacy
!results/track_a_aggregations
!results/track_a_aggregations/**
!envs/.gitkeep
tests/toy_3locus/results/

# --- Figures: commit tracked outputs, but skip scratch ---
figures/scratch/
figures/tmp/

# --- Large binary / genomics files ---
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.bcf
*.bcf.csi
*.bgen
*.bgen.bgi
*.bed
*.bim
*.fam
*.plink
*.ld
*.ldmatrix
*.rds
!tests/**/fixtures/*.rds
*.RData
*.h5
*.hdf5
*.npy
*.npz
*.parquet
*.feather
*.bam
*.bai
*.cram
*.crai
*.fasta
*.fa
*.fa.gz
*.fasta.gz
*.fq
*.fq.gz
*.fastq
*.fastq.gz
*.sam
*.sam.gz

# --- tmp / scratch ---
tmp/
scratch/
*.tmp
*.tmp.*
.cache/

# --- GSD transient state (keep persistent state like PROJECT.md) ---
.planning/**/tmp/
.planning/**/*.lock

# --- Synapse auth (T-02-08: never commit auth tokens) ---
.synapseConfig
.synapse_auth*

# --- Claude Code local state ---
.claude/local/
tools/ldsc/

# M2 toy 3-locus smoke output (REQ-SNAKEMAKE-CI extension; regenerable via snakemake)
tests/toy_3locus/m2_smoke_out/

# M3 AoU LD panel build (per AOU-LD-PIPELINE.md §10.2)
data/interim/aou_ld_exports/
data/processed/ld_reference/AFR_aou/
data/processed/ld_reference/EUR_aou/
tests/m3/fixtures/synthetic_mt/
