"""Smoke test Snakefile for the toy 3-locus CI test (D-15, REQ-9).

Uses the SAME production rules from src/snakemake/rules/ but with
config_test.yaml overriding paths to tests/toy_3locus/ data.

Invocation (from project root):
    snakemake --snakefile tests/toy_3locus/Snakefile.test --cores 2 --use-conda
    snakemake -n --snakefile tests/toy_3locus/Snakefile.test  # dry-run

Only targets: harmonization, region BED, LD reference, fine-mapping.
No multitrait, MR, or PGS rules (out of scope for smoke test).
"""

import os
import csv
import yaml

# ---------------------------------------------------------------------------
# Config loading and validation
# ---------------------------------------------------------------------------
configfile: "tests/toy_3locus/config_test.yaml"

from snakemake.utils import validate
# Schema path is resolved relative to this Snakefile (tests/toy_3locus/), so use ../.. to reach project root
validate(config, "../../src/snakemake/schemas/pipeline.schema.yaml")

# ---------------------------------------------------------------------------
# Global variables derived from config (mirrors production Snakefile)
# ---------------------------------------------------------------------------
TRAITS = config["traits"]
ANCESTRIES = config["ancestries"]
TRAIT_ANCESTRIES = config.get("trait_ancestries", {})

HARMONIZED_DIR = config["paths"]["harmonized_sumstats"]

# Build trait-ancestry pairs from trait_ancestries mapping
TRAIT_ANCESTRY_PAIRS = []
for _trait in TRAITS:
    _ancestries = TRAIT_ANCESTRIES.get(_trait, ANCESTRIES)
    for _anc in _ancestries:
        TRAIT_ANCESTRY_PAIRS.append((_trait, _anc))

# ---------------------------------------------------------------------------
# Load toy regions from config path
# ---------------------------------------------------------------------------
REGION_INFOS = []
REGION_SAFE_TO_ID = {}
REGION_METADATA = {}
with open(config["paths"]["regions_curated"], newline="") as fh:
    reader = csv.DictReader(fh)
    for row in reader:
        orig = row["region_id"]
        safe = orig.replace(".", "_").replace("/", "_")
        suffix = 1
        while safe in REGION_SAFE_TO_ID:
            suffix += 1
            safe = f"{safe}_{suffix}"
        start = int(float(row["start"]))
        end = int(float(row["end"]))
        chrom = row["chr"].replace("chr", "").replace("CHR", "")
        REGION_INFOS.append((orig, safe))
        REGION_SAFE_TO_ID[safe] = orig
        REGION_METADATA[safe] = {"chr": chrom, "start": start, "end": end}

REGION_SAFE_IDS = [safe for _, safe in REGION_INFOS]

# ---------------------------------------------------------------------------
# Build target lists needed by included rules (must precede includes)
# ---------------------------------------------------------------------------
HARMONIZED_ALL = [
    os.path.join(HARMONIZED_DIR, f"{trait}.{ancestry}.tsv.bgz")
    for trait, ancestry in TRAIT_ANCESTRY_PAIRS
]

# Fine-mapping config (needed before finemap.smk include)
FINEMAP_CONFIG = config.get("finemap", {})
FINEMAP_METHODS = FINEMAP_CONFIG.get("methods", [])
FINEMAP_DIR = FINEMAP_CONFIG.get(
    "output_dir",
    os.path.join(config["paths"]["results_root"], "fine_mapping"),
)

if FINEMAP_METHODS:
    FINEMAP_MANIFEST = os.path.join(FINEMAP_DIR, "finemap_manifest.tsv")
    UNIQUE_TRAIT_ANC = sorted(set(TRAIT_ANCESTRY_PAIRS))
    # These globals must be defined BEFORE the finemap.smk include because
    # finemap.smk references them at parse time in rule input/output bindings.
    # Must mirror the production Snakefile's variable set exactly.
    FINEMAP_OUTPUTS = [
        os.path.join(FINEMAP_DIR, method, f"{trait}.{ancestry}.{region_safe}.json")
        for method in FINEMAP_METHODS
        for trait, ancestry in UNIQUE_TRAIT_ANC
        for _, region_safe in REGION_INFOS
    ]
    FINEMAP_SUMMARY = os.path.join(FINEMAP_DIR, "finemap_summary.tsv")
else:
    FINEMAP_MANIFEST = None
    UNIQUE_TRAIT_ANC = []
    FINEMAP_OUTPUTS = []
    FINEMAP_SUMMARY = None

# ---------------------------------------------------------------------------
# Include the SAME production rules (D-04: refactor, not rewrite)
# Paths are resolved relative to this Snakefile (tests/toy_3locus/), so use
# ../.. to reach project root where src/snakemake/rules/ lives.
# ---------------------------------------------------------------------------
include: "../../src/snakemake/rules/sumstats.smk"
include: "../../src/snakemake/rules/regions.smk"

if FINEMAP_METHODS:
    include: "../../src/snakemake/rules/finemap.smk"

# QC rules (Phase 1 Plan 01-05 + 01-06: susie QC dashboard)
include: "../../src/snakemake/rules/qc.smk"

# M2 smoke targets (Wave 5 m2-05 Task 2; REQ-SNAKEMAKE-CI extension)
include: "m2_smoke_targets.smk"

# LD reference (conditional)
ENABLE_LD = config.get("enable_ld_pipeline", False)
# Only generate LD targets for ancestries with 1000G population mappings
LD_ANCESTRIES = [a for a in ANCESTRIES if a in config.get("onekg", {}).get("populations", {})]
# Only generate LD targets for regions whose chromosome has a 1000G VCF
ONEKG_CHROMS = set(config.get("onekg", {}).get("chromosomes", []))
LD_REGION_INFOS = [(orig, safe) for orig, safe in REGION_INFOS if REGION_METADATA[safe]["chr"] in ONEKG_CHROMS]
if ENABLE_LD:
    include: "../../src/snakemake/rules/ld_reference.smk"
    LD_TARGETS = [
        os.path.join(
            config["paths"]["ld_reference"],
            ancestry,
            f"{region_safe}.rds",
        )
        for ancestry in LD_ANCESTRIES
        for _, region_safe in LD_REGION_INFOS
    ]
else:
    LD_TARGETS = []

# ---------------------------------------------------------------------------
# Toy targets: harmonization + region BED + LD + finemap only
# No multitrait, MR, PGS in the smoke test
# FINEMAP_OUTPUTS is defined earlier (above the finemap.smk include) — do not
# redefine it here.
# ---------------------------------------------------------------------------

# QC dashboard targets (Phase 1 Plan 01-05/01-06)
QC_TARGETS = []
if FINEMAP_METHODS:
    QC_TARGETS = [
        os.path.join(FINEMAP_DIR, "finemap_summary.tsv"),
        os.path.join(FINEMAP_DIR, "finemap_summary_augmented.tsv"),
        os.path.join(FINEMAP_DIR, "qc_aggregated.tsv"),
        os.path.join(FINEMAP_DIR, "sweep_complex_regions.tsv"),
        os.path.join(FINEMAP_DIR, "qc_dashboard.html"),
    ]

M2_SMOKE_TARGETS = [
    "tests/toy_3locus/m2_smoke_out/EUR/residcov.txt",
    "tests/toy_3locus/m2_smoke_out/EUR/residcov.trait_order.json",
]

ALL_TARGETS = (
    HARMONIZED_ALL
    + [config["paths"]["regions_bed"]]
    + LD_TARGETS
    + FINEMAP_OUTPUTS
    + QC_TARGETS
    + M2_SMOKE_TARGETS
)

rule all:
    input:
        ALL_TARGETS
